# Réglages lus par Cloudflare Pages (en-têtes envoyés avec les pages)
# L'adresse technique <projet>.pages.dev montre le même site que clutchcrosshair.com :
# on demande à Google de ne pas l'indexer (sinon il verrait deux sites identiques).
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# En-têtes de sécurité, sur toutes les pages et tous les fichiers (audit du 10/11/2026) :
#   Strict-Transport-Security : le navigateur n'utilise plus jamais http:// pour ce site (1 an)
#   X-Content-Type-Options    : le navigateur ne devine pas le type d'un fichier (un .txt ne peut pas être lu comme un script)
#   X-Frame-Options           : le site ne peut pas être affiché dans le cadre d'un autre site (faux clics)
#   Permissions-Policy        : le site n'a besoin ni de la caméra, ni du micro, ni de la position
# (Referrer-Policy est déjà envoyé par Cloudflare. Pas encore de Content-Security-Policy : les pages contiennent
#  de petits scripts écrits dans le HTML, il faudra la tester avant de l'activer.)
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Mise en cache dans le navigateur des visiteurs (site plus rapide quand on revient)
# CSS / JS : 1 an, sans risque, car chaque page les appelle avec une empreinte ?v= qui change à chaque modification
# (node build.js). Ne JAMAIS appeler ces fichiers sans ?v= (sinon les visiteurs garderaient l'ancienne version).
/style.css
  Cache-Control: public, max-age=31536000, immutable
/crosshair.js
  Cache-Control: public, max-age=31536000, immutable
/script.js
  Cache-Control: public, max-age=31536000, immutable
/generator.js
  Cache-Control: public, max-age=31536000, immutable
/consent.js
  Cache-Control: public, max-age=31536000, immutable
/lang-banner.js
  Cache-Control: public, max-age=31536000, immutable
# Versions minifiées (celles que les pages chargent vraiment)
/style.min.css
  Cache-Control: public, max-age=31536000, immutable
/crosshair.min.js
  Cache-Control: public, max-age=31536000, immutable
/script.min.js
  Cache-Control: public, max-age=31536000, immutable
/generator.min.js
  Cache-Control: public, max-age=31536000, immutable
/consent.min.js
  Cache-Control: public, max-age=31536000, immutable
/lang-banner.min.js
  Cache-Control: public, max-age=31536000, immutable
# Le jeu « Zero to Major » (/career) : code et données, appelés avec une empreinte ?v=
/career.js
  Cache-Control: public, max-age=31536000, immutable
/career.min.js
  Cache-Control: public, max-age=31536000, immutable
/career-engine.js
  Cache-Control: public, max-age=31536000, immutable
/career-engine.min.js
  Cache-Control: public, max-age=31536000, immutable
/career.en.json
  Cache-Control: public, max-age=31536000, immutable
/career.fr.json
  Cache-Control: public, max-age=31536000, immutable

# Polices : ne changent jamais -> 1 an
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Librairie de décodage (appelée sans ?v=, change très rarement) -> 30 jours
/lib/*
  Cache-Control: public, max-age=2592000
# Drapeaux du jeu « Zero to Major » (appelés sans ?v=, ne changent presque jamais) -> 30 jours
/flags/*
  Cache-Control: public, max-age=2592000

# Images : 1 an. Une photo, un logo ou un fond remplacé garde son nom, mais build.js l'appelle avec une empreinte ?v=
# (nouvelle image = nouvelle adresse). Les images des skins ont un nom tiré de leur contenu.
/photos/*
  Cache-Control: public, max-age=31536000, immutable
/logos/*
  Cache-Control: public, max-age=31536000, immutable
/skins/img/*
  Cache-Control: public, max-age=31536000, immutable
/preview-bg.webp
  Cache-Control: public, max-age=31536000, immutable
/preview-bg-crop.webp
  Cache-Control: public, max-age=31536000, immutable
/og/*
  Cache-Control: public, max-age=31536000, immutable
